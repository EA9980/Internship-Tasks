/* Reset */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

/* Body Styling */
body {
    font-family: Arial, sans-serif;
    background: linear-gradient(to right, #eef2f3, #dfe9f3);
}

/* Header */
.header {
    background-color: #15e576;
    color: white;
    text-align: center;
    padding: 25px;              /* Padding */
    margin-bottom: 20px;        /* Margin */
}

.header span {
    color: #f39c12;
}

/* Container */
.container {
    width: 90%;
    margin: 20px auto;          /* Center alignment */
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
}

/* Card Design */
.card {
    background-color: white;
    width: 30%;
    border: 2px solid #3498db;  /* Border */
    border-radius: 10px;
    padding: 20px;              /* Padding inside card */
    margin-bottom: 20px;        /* Space between rows */
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);  /* Box shadow */
    transition: 0.3s;
}

/* Hover Effect */
.card:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
}

/* Card Text */
.card h4 {
    margin-bottom: 10px;
    color: #2c3e50;
}

.card p {
    margin-bottom: 10px;
    color: #555;
}

.card h5 {
    margin-bottom: 15px;
    color: #e74c3c;
}

/* Button Styling */
button {
    background-color: #3498db;
    border: none;
    padding: 10px 15px;
    border-radius: 5px;
    cursor: pointer;
}

button a {
    text-decoration: none;
    color: white;
    font-weight: bold;
}

button:hover {
    background-color: #2980b9;
}

/* Responsive Design */
@media (max-width: 992px) {
    .card {
        width: 45%;
    }
}

@media (max-width: 600px) {
    .card {
        width: 100%;
    }
}
