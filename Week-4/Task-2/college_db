//creating database
CREATE DATABASE college_db;
USE college_db;

//creating table users
CREATE TABLE Users (
    id INT PRIMARY KEY AUTO_INCREMENT,
    username VARCHAR(50),
    email VARCHAR(100),
    password VARCHAR(50)
);

//creating table student 
CREATE TABLE Students (
    id INT PRIMARY KEY AUTO_INCREMENT,
    name VARCHAR(100),
    age INT,
    course VARCHAR(100)
);

//creating table task
CREATE TABLE Tasks (
    id INT PRIMARY KEY AUTO_INCREMENT,
    task_name VARCHAR(100),
    due_date DATE,
    status VARCHAR(50)
);

